{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "site": "luksmusic",
      "public": "web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "tools/**"
      ],
      "headers": [
        {
          "source": "**/*.@(otf|ttf|woff|woff2)",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Cache-Control",
              "value": "max-age=31536000"
            }
          ]
        },
        {
          "source": "**/*.@(mp3|ogg|wav|json)",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            },
            {
              "key": "Cache-Control",
              "value": "max-age=86400"
            }
          ]
        }
      ]
    },
    {
      "site": "luksmusic-5a7ff",
      "public": "web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "tools/**"
      ]
    }
  ]
}

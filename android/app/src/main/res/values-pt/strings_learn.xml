    <!-- The course (core/lessons/LessonCatalog.kt) -->
    <string name="learn_c_drill">Sem ajuda. Se errar duas vezes, a tecla acende.</string>
    <string name="learn_c_at_your_pace">Toque em Ouvir para escutar, depois leia e toque no seu ritmo.</string>
    <string name="learn_m_treble_title">Clave de sol</string>
    <string name="learn_m_treble_summary">Mão direita, do Dó central para cima</string>
    <string name="learn_l_treble_1_title">Como ler a partitura</string>
    <string name="learn_l_treble_1_summary">Vídeo de introdução, suas primeiras notas e sua primeira música</string>
    <string name="learn_l_treble_1_s1_title">Como a partitura começa</string>
    <string name="learn_l_treble_1_s1_text">Veja como as linhas funcionam e como cada tecla sobe meia linha até completar uma oitava.</string>
    <string name="learn_l_treble_1_s2_title">Ache o Dó, o Ré e o Mi</string>
    <string name="learn_l_treble_1_s2_text">O Dó fica à esquerda das 2 teclas pretas, na linha curta abaixo da pauta. Cada tecla para a direita sobe meia linha. Toque Dó, Ré e Mi.</string>
    <string name="learn_l_treble_1_s3_title">Subindo uma oitava</string>
    <string name="learn_l_treble_1_s3_text">Agora suba uma tecla por nota até o próximo Dó, exatamente como você viu no vídeo.</string>
    <string name="learn_l_treble_1_s4_title">Música: Au Clair de la Lune (trecho)</string>
    <string name="learn_l_treble_1_s4_text">Hora da música! Toque a primeira frase desta melodia tradicional francesa usando só Dó, Ré e Mi.</string>
    <string name="learn_l_treble_1_s5_title">Desafio: Au Clair de la Lune completa</string>
    <string name="learn_l_treble_1_s5_text">Para fechar a aula, toque a melodia completa sozinho do começo ao fim.</string>
    <string name="learn_l_treble_2_title">Dó, Ré, Mi</string>
    <string name="learn_l_treble_2_summary">As três primeiras notas</string>
    <string name="learn_l_treble_2_s1_title">Nota nova: Ré</string>
    <string name="learn_l_treble_2_s1_text">É a tecla branca logo à direita do Dó. Na pauta, fica logo abaixo da primeira linha. Toque o Ré.</string>
    <string name="learn_l_treble_2_s2_title">Nota nova: Mi</string>
    <string name="learn_l_treble_2_s2_text">É a tecla branca seguinte. Na pauta, fica em cima da primeira linha. Toque o Mi.</string>
    <string name="learn_l_treble_2_s3_title">Treino</string>
    <string name="learn_l_treble_2_s3_text">Dez notas sorteadas entre Dó, Ré e Mi.</string>
    <string name="learn_l_treble_2_s4_title">Música: Hot Cross Buns</string>
    <string name="learn_l_treble_2_s4_text">Uma canção infantil inglesa só com Mi, Ré e Dó.</string>
    <string name="learn_l_treble_3_title">Fá e Sol</string>
    <string name="learn_l_treble_3_summary">A clave de sol marca a linha do Sol</string>
    <string name="learn_l_treble_3_s1_title">Nota nova: Fá</string>
    <string name="learn_l_treble_3_s1_text">É a tecla branca logo à esquerda do grupo de 3 teclas pretas. Na pauta, fica no primeiro espaço. Toque o Fá.</string>
    <string name="learn_l_treble_3_s2_title">Nota nova: Sol</string>
    <string name="learn_l_treble_3_s2_text">Fica na segunda linha, a que a curva da clave de sol envolve. É daí que vem o nome da clave. Toque o Sol.</string>
    <string name="learn_l_treble_3_s3_title">Treino</string>
    <string name="learn_l_treble_3_s3_text">Dez notas sorteadas do Dó ao Sol.</string>
    <string name="learn_l_treble_3_s4_title">Música: Ode à Alegria (trecho)</string>
    <string name="learn_l_treble_3_s4_text">Experimente o início do tema de Beethoven usando do Ré ao Sol.</string>
    <string name="learn_l_treble_3_s5_title">Desafio: Ode à Alegria</string>
    <string name="learn_l_treble_3_s5_text">Agora toque a frase completa de Beethoven sozinho.</string>
    <string name="learn_l_treble_4_title">Lá, Si e o outro Dó</string>
    <string name="learn_l_treble_4_summary">Até o Dó de cima</string>
    <string name="learn_l_treble_4_s1_title">Nota nova: Lá</string>
    <string name="learn_l_treble_4_s1_text">Vem depois do Sol. Na pauta, fica no segundo espaço. Toque o Lá.</string>
    <string name="learn_l_treble_4_s2_title">Nota nova: Si</string>
    <string name="learn_l_treble_4_s2_text">Fica na terceira linha, bem no meio da pauta. Toque o Si.</string>
    <string name="learn_l_treble_4_s3_title">Nota nova: o Dó de cima</string>
    <string name="learn_l_treble_4_s3_text">Depois do Si, os nomes recomeçam. Este Dó é o oitavo som a partir do Dó central e fica no terceiro espaço. Toque-o.</string>
    <string name="learn_l_treble_4_s4_title">Treino</string>
    <string name="learn_l_treble_4_s4_text">Dez notas sorteadas do Dó central ao Dó de cima.</string>
    <string name="learn_l_treble_4_s5_title">Música: Brilha, Brilha, Estrelinha (trecho)</string>
    <string name="learn_l_treble_4_s5_text">Toque a abertura desta melodia tradicional subindo até o Lá.</string>
    <string name="learn_l_treble_4_s6_title">Desafio: Brilha, Brilha, Estrelinha</string>
    <string name="learn_l_treble_4_s6_text">Agora toque o trecho completo sozinho até voltar ao Dó.</string>
    <string name="learn_l_treble_5_title">A escala subindo</string>
    <string name="learn_l_treble_5_summary">Do Dó central ao Dó de cima</string>
    <string name="learn_l_treble_5_s1_title">A escala de Dó</string>
    <string name="learn_l_treble_5_s1_text">São oito notas vizinhas, todas em teclas brancas. Na pauta, cada nota sobe um degrau: linha, espaço, linha, espaço. Suba pelas teclas acesas.</string>
    <string name="learn_l_treble_5_s2_title">Subindo sem ajuda</string>
    <string name="learn_l_treble_5_s2_text">Leia a pauta e suba até o Dó de cima.</string>
    <string name="learn_l_treble_5_s3_title">Linhas e espaços</string>
    <string name="learn_l_treble_5_s3_text">Primeiro as notas nas linhas, depois as dos espaços: pulando uma tecla de cada vez.</string>
    <string name="learn_l_treble_6_title">A escala descendo</string>
    <string name="learn_l_treble_6_summary">O caminho de volta</string>
    <string name="learn_l_treble_6_s1_title">Descendo</string>
    <string name="learn_l_treble_6_s1_text">Agora o caminho contrário: comece no Dó de cima e desça um degrau por vez até o Dó central, pelas teclas acesas.</string>
    <string name="learn_l_treble_6_s2_title">Descendo sem ajuda</string>
    <string name="learn_l_treble_6_s2_text">Leia a pauta e desça até o Dó central.</string>
    <string name="learn_l_treble_6_s3_title">Treino</string>
    <string name="learn_l_treble_6_s3_text">Dez notas sorteadas do Dó ao Dó.</string>
    <string name="learn_l_treble_7_title">Ré, Mi, Fá e Sol de cima</string>
    <string name="learn_l_treble_7_summary">O alto da pauta</string>
    <string name="learn_l_treble_7_s1_title">Notas novas: Ré e Mi</string>
    <string name="learn_l_treble_7_s1_text">O Ré fica na quarta linha, e o Mi no quarto espaço. Toque os dois.</string>
    <string name="learn_l_treble_7_s2_title">Notas novas: Fá e Sol</string>
    <string name="learn_l_treble_7_s2_text">O Fá fica na quinta linha, a última. O Sol fica logo acima dela. Toque os dois.</string>
    <string name="learn_l_treble_7_s3_title">Treino</string>
    <string name="learn_l_treble_7_s3_text">Dez notas sorteadas do Sol ao Sol de cima.</string>
    <string name="learn_l_treble_7_s4_title">Música: Ode à Alegria, uma oitava acima</string>
    <string name="learn_l_treble_7_s4_text">A mesma melodia da aula Fá e Sol, oito notas mais aguda: mesmas teclas, mais à direita.</string>
    <string name="learn_l_treble_8_title">Linhas extras em cima</string>
    <string name="learn_l_treble_8_summary">Lá, Si e Dó acima da pauta</string>
    <string name="learn_l_treble_8_s1_title">Nota nova: Lá agudo</string>
    <string name="learn_l_treble_8_s1_text">Quando a nota passa das cinco linhas, a pauta ganha linhas curtas. O Lá fica na primeira linha curta acima da pauta. Toque o Lá.</string>
    <string name="learn_l_treble_8_s2_title">Notas novas: Si e Dó agudos</string>
    <string name="learn_l_treble_8_s2_text">O Si fica logo acima dessa linha. O Dó fica na segunda linha curta. Toque os dois.</string>
    <string name="learn_l_treble_8_s3_title">Treino</string>
    <string name="learn_l_treble_8_s3_text">Dez notas sorteadas no alto da pauta.</string>
    <string name="learn_l_treble_9_title">Desafio da clave de sol</string>
    <string name="learn_l_treble_9_summary">Leitura da pauta inteira e música completa</string>
    <string name="learn_l_treble_9_s1_title">Até o Dó de cima</string>
    <string name="learn_l_treble_9_s1_text">Dez notas sorteadas.</string>
    <string name="learn_l_treble_9_s2_title">Pauta inteira</string>
    <string name="learn_l_treble_9_s2_text">Dez notas sorteadas, do Dó central ao Dó mais alto.</string>
    <string name="learn_l_treble_9_s3_title">Desafio: Ode à Alegria completa</string>
    <string name="learn_l_treble_9_s3_text">Toque as duas partes completas do tema de Beethoven sozinho para concluir o módulo.</string>
    <string name="learn_m_bass_title">Clave de fá</string>
    <string name="learn_m_bass_summary">Mão esquerda, do Dó central para baixo</string>
    <string name="learn_l_bass_1_title">A clave de fá</string>
    <string name="learn_l_bass_1_summary">A pauta da mão esquerda</string>
    <string name="learn_l_bass_1_s1_title">Nota nova: o Fá da clave</string>
    <string name="learn_l_bass_1_s1_text">A mão esquerda costuma ler esta clave. Os dois pontos dela ficam em volta da quarta linha, e essa linha é o Fá. Toque com a mão esquerda.</string>
    <string name="learn_l_bass_1_s2_title">O mesmo Dó central</string>
    <string name="learn_l_bass_1_s2_text">Nesta clave, o Dó central fica numa linha curta acima das cinco linhas. É a mesma tecla da clave de sol. Toque-o.</string>
    <string name="learn_l_bass_1_s3_title">Sua vez</string>
    <string name="learn_l_bass_1_s3_text">Leia a pauta: só Fá e Dó.</string>
    <string name="learn_l_bass_2_title">Si, Lá e Sol</string>
    <string name="learn_l_bass_2_summary">Descendo a partir do Dó central</string>
    <string name="learn_l_bass_2_s1_title">Nota nova: Si</string>
    <string name="learn_l_bass_2_s1_text">É a tecla logo à esquerda do Dó central. Na pauta, fica logo acima da quinta linha. Toque o Si.</string>
    <string name="learn_l_bass_2_s2_title">Notas novas: Lá e Sol</string>
    <string name="learn_l_bass_2_s2_text">O Lá fica na quinta linha, a de cima. O Sol fica no quarto espaço. Toque os dois.</string>
    <string name="learn_l_bass_2_s3_title">Treino</string>
    <string name="learn_l_bass_2_s3_text">Dez notas sorteadas do Dó central ao Fá.</string>
    <string name="learn_l_bass_2_s4_title">Música: Hot Cross Buns com a mão esquerda</string>
    <string name="learn_l_bass_2_s4_text">A canção da clave de sol, agora com Si, Lá e Sol.</string>
    <string name="learn_l_bass_3_title">Mi, Ré e Dó</string>
    <string name="learn_l_bass_3_summary">O meio da pauta da mão esquerda</string>
    <string name="learn_l_bass_3_s1_title">Nota nova: Mi</string>
    <string name="learn_l_bass_3_s1_text">Fica no terceiro espaço, logo abaixo do Fá. Toque o Mi.</string>
    <string name="learn_l_bass_3_s2_title">Notas novas: Ré e Dó</string>
    <string name="learn_l_bass_3_s2_text">O Ré fica na terceira linha, no meio da pauta. O Dó fica no segundo espaço. Toque os dois.</string>
    <string name="learn_l_bass_3_s3_title">Treino</string>
    <string name="learn_l_bass_3_s3_text">Dez notas sorteadas do Dó central ao Dó de baixo.</string>
    <string name="learn_l_bass_3_s4_title">Música: Ode à Alegria com a mão esquerda</string>
    <string name="learn_l_bass_3_s4_text">O tema de Beethoven oito notas abaixo.</string>
    <string name="learn_l_bass_4_title">Descendo e subindo</string>
    <string name="learn_l_bass_4_summary">Do Dó central ao Dó de baixo, e de volta</string>
    <string name="learn_l_bass_4_s1_title">A escala na clave de fá</string>
    <string name="learn_l_bass_4_s1_text">As mesmas oito notas de nomes, uma oitava abaixo: do Dó central ao Dó do segundo espaço. Desça pelas teclas acesas.</string>
    <string name="learn_l_bass_4_s2_title">Descendo sem ajuda</string>
    <string name="learn_l_bass_4_s2_text">Leia a pauta e desça.</string>
    <string name="learn_l_bass_4_s3_title">Subindo sem ajuda</string>
    <string name="learn_l_bass_4_s3_text">Agora o caminho contrário.</string>
    <string name="learn_l_bass_5_title">As notas mais graves</string>
    <string name="learn_l_bass_5_summary">Até o Dó com linhas extras embaixo</string>
    <string name="learn_l_bass_5_s1_title">Notas novas: Si, Lá e Sol graves</string>
    <string name="learn_l_bass_5_s1_text">O Si fica na segunda linha, o Lá no primeiro espaço, e o Sol na primeira linha. Toque os três.</string>
    <string name="learn_l_bass_5_s2_title">Abaixo da pauta</string>
    <string name="learn_l_bass_5_s2_text">O Fá fica logo abaixo da primeira linha. O Mi fica numa linha curta, o Ré logo abaixo dela, e o Dó na segunda linha curta. Toque os quatro.</string>
    <string name="learn_l_bass_5_s3_title">Treino</string>
    <string name="learn_l_bass_5_s3_text">Dez notas sorteadas no grave.</string>
    <string name="learn_l_bass_6_title">Desafio da clave de fá</string>
    <string name="learn_l_bass_6_summary">Notas sorteadas, sem ajuda</string>
    <string name="learn_l_bass_6_s1_title">Até o Dó de baixo</string>
    <string name="learn_l_bass_6_s1_text">Dez notas sorteadas.</string>
    <string name="learn_l_bass_6_s2_title">Pauta inteira</string>
    <string name="learn_l_bass_6_s2_text">Dez notas sorteadas, do Dó central ao Dó mais grave.</string>
    <string name="learn_m_grand_title">As duas claves</string>
    <string name="learn_m_grand_summary">O piano inteiro numa pauta dupla</string>
    <string name="learn_l_grand_1_title">O Dó central é o mesmo</string>
    <string name="learn_l_grand_1_summary">Onde as duas claves se encontram</string>
    <string name="learn_l_grand_1_s1_title">Duas pautas, um piano</string>
    <string name="learn_l_grand_1_s1_text">A clave de fá escreve a metade esquerda do piano e a clave de sol, a metade direita. Elas se encontram no Dó central, que aparece na linha curta de cada uma. Toque-o duas vezes.</string>
    <string name="learn_l_grand_1_s2_title">Subindo o teclado</string>
    <string name="learn_l_grand_1_s2_text">Da esquerda para a direita, as notas sobem pela pauta de baixo e continuam na de cima. Comece com a mão esquerda e passe para a direita no Dó central.</string>
    <string name="learn_l_grand_1_s3_title">Descendo sem ajuda</string>
    <string name="learn_l_grand_1_s3_text">Leia as duas pautas.</string>
    <string name="learn_l_grand_2_title">Lendo as duas pautas</string>
    <string name="learn_l_grand_2_summary">A nota pode vir de qualquer clave</string>
    <string name="learn_l_grand_2_s1_title">Qual pauta?</string>
    <string name="learn_l_grand_2_s1_text">Primeiro veja a clave, depois a nota.</string>
    <string name="learn_l_grand_2_s2_title">Treino</string>
    <string name="learn_l_grand_2_s2_text">Dez notas sorteadas nas duas pautas.</string>
    <string name="learn_l_grand_3_title">Desafio das duas claves</string>
    <string name="learn_l_grand_3_summary">Notas sorteadas nas duas pautas</string>
    <string name="learn_l_grand_3_s1_title">Desafio</string>
    <string name="learn_l_grand_3_s1_text">Dezesseis notas sorteadas nas duas pautas.</string>
    <string name="learn_m_accidentals_title">Sustenido e bemol</string>
    <string name="learn_m_accidentals_summary">As teclas pretas</string>
    <string name="learn_l_acc_1_title">O sustenido</string>
    <string name="learn_l_acc_1_summary">Sobe a nota meio tom</string>
    <string name="learn_l_acc_1_s1_title">O sinal ♯</string>
    <string name="learn_l_acc_1_s1_text">O sustenido sobe a nota meio tom: toque a tecla logo à direita. Ele fica antes da nota, na mesma altura dela. Toque Fá e Fá♯.</string>
    <string name="learn_l_acc_1_s2_title">As teclas pretas</string>
    <string name="learn_l_acc_1_s2_text">Dó♯, Ré♯, Fá♯, Sol♯ e Lá♯ são as cinco teclas pretas de cada oitava. Toque as cinco.</string>
    <string name="learn_l_acc_1_s3_title">Treino</string>
    <string name="learn_l_acc_1_s3_text">Dez notas sorteadas, brancas e pretas.</string>
    <string name="learn_l_acc_2_title">O bemol</string>
    <string name="learn_l_acc_2_summary">Desce a nota meio tom</string>
    <string name="learn_l_acc_2_s1_title">O sinal ♭</string>
    <string name="learn_l_acc_2_s1_text">O bemol desce a nota meio tom: toque a tecla logo à esquerda. Toque Si e Si♭.</string>
    <string name="learn_l_acc_2_s2_title">As teclas pretas de novo</string>
    <string name="learn_l_acc_2_s2_text">Ré♭, Mi♭, Sol♭, Lá♭ e Si♭ são as mesmas cinco teclas pretas, com outros nomes. Toque as cinco.</string>
    <string name="learn_l_acc_2_s3_title">Treino</string>
    <string name="learn_l_acc_2_s3_text">Dez notas sorteadas, brancas e pretas.</string>
    <string name="learn_l_acc_3_title">Uma tecla, dois nomes</string>
    <string name="learn_l_acc_3_summary">Dó♯ e Ré♭ são a mesma tecla</string>
    <string name="learn_l_acc_3_s1_title">O mesmo som</string>
    <string name="learn_l_acc_3_s1_text">Dó♯ e Ré♭ se escrevem em lugares diferentes da pauta, mas são a mesma tecla preta. Toque as duas.</string>
    <string name="learn_l_acc_3_s2_title">Pares</string>
    <string name="learn_l_acc_3_s2_text">Cada par de notas vizinhas é uma tecla só.</string>
    <string name="learn_l_acc_4_title">O bequadro</string>
    <string name="learn_l_acc_4_summary">Cancela o sustenido ou o bemol</string>
    <string name="learn_l_acc_4_s1_title">Vale até o fim do compasso</string>
    <string name="learn_l_acc_4_s1_text">Depois de um sustenido, as mesmas notas seguintes continuam alteradas até a barra de compasso, mesmo sem o sinal. Toque os dois Fá♯.</string>
    <string name="learn_l_acc_4_s2_title">O sinal ♮</string>
    <string name="learn_l_acc_4_s2_text">O bequadro cancela a alteração, e a nota volta à tecla branca. Toque as três.</string>
    <string name="learn_l_acc_4_s3_title">A barra apaga o sinal</string>
    <string name="learn_l_acc_4_s3_text">No segundo compasso, o sustenido precisa aparecer de novo. Atenção à nota sem sinal.</string>
    <string name="learn_l_acc_5_title">Desafio dos sinais</string>
    <string name="learn_l_acc_5_summary">Brancas e pretas sorteadas</string>
    <string name="learn_l_acc_5_s1_title">Sustenidos</string>
    <string name="learn_l_acc_5_s1_text">Dez notas sorteadas.</string>
    <string name="learn_l_acc_5_s2_title">Bemóis</string>
    <string name="learn_l_acc_5_s2_text">Dez notas sorteadas.</string>
    <string name="learn_m_rhythm_title">Ritmo</string>
    <string name="learn_m_rhythm_summary">Quanto tempo cada nota dura</string>
    <string name="learn_l_rhy_1_title">O pulso e a semínima</string>
    <string name="learn_l_rhy_1_summary">Tocar junto com o metrônomo</string>
    <string name="learn_l_rhy_1_s1_title">Uma nota por pulso</string>
    <string name="learn_l_rhy_1_s1_text">A música tem uma batida regular, o pulso, que o metrônomo marca. A semínima dura um pulso. Toque em Começar: o metrônomo conta 4 tempos e você toca uma nota em cada clique.</string>
    <string name="learn_l_rhy_1_s2_title">Mudando de nota</string>
    <string name="learn_l_rhy_1_s2_text">O mesmo pulso, com notas diferentes.</string>
    <string name="learn_l_rhy_2_title">Mínima e semibreve</string>
    <string name="learn_l_rhy_2_summary">Notas de 2 e de 4 pulsos</string>
    <string name="learn_l_rhy_2_s1_title">A mínima</string>
    <string name="learn_l_rhy_2_s1_text">A mínima tem a cabeça vazia e dura dois pulsos: toque e segure por dois cliques.</string>
    <string name="learn_l_rhy_2_s2_title">A semibreve</string>
    <string name="learn_l_rhy_2_s2_text">A semibreve não tem haste e dura quatro pulsos, o compasso inteiro.</string>
    <string name="learn_l_rhy_3_title">O compasso</string>
    <string name="learn_l_rhy_3_summary">Os pulsos agrupados</string>
    <string name="learn_l_rhy_3_s1_title">Dois compassos</string>
    <string name="learn_l_rhy_3_s1_text">As barras dividem a música em grupos de pulsos. O 4 de cima diz que cada compasso tem quatro pulsos; o 4 de baixo, que a semínima vale um pulso. O primeiro clique de cada compasso é mais forte.</string>
    <string name="learn_l_rhy_3_s2_title">Música: Mary Had a Little Lamb</string>
    <string name="learn_l_rhy_3_s2_text">Agora uma canção no tempo, com o app tocando junto.</string>
    <string name="learn_l_rhy_4_title">Pausas</string>
    <string name="learn_l_rhy_4_summary">O silêncio também tem duração</string>
    <string name="learn_l_rhy_4_s1_title">Pausa de semínima</string>
    <string name="learn_l_rhy_4_s1_text">A pausa é um tempo em silêncio. Esta dura um pulso: não toque nada e espere o clique seguinte.</string>
    <string name="learn_l_rhy_4_s2_title">Pausas longas</string>
    <string name="learn_l_rhy_4_s2_text">A pausa de mínima fica em cima da terceira linha e dura dois pulsos. Conte os cliques durante ela.</string>
    <string name="learn_l_rhy_5_title">Colcheias</string>
    <string name="learn_l_rhy_5_summary">Duas notas em cada pulso</string>
    <string name="learn_l_rhy_5_s1_title">Duas por pulso</string>
    <string name="learn_l_rhy_5_s1_text">A colcheia tem uma bandeirinha e dura meio pulso: uma no clique e a outra entre os cliques.</string>
    <string name="learn_l_rhy_5_s2_title">Música: Hot Cross Buns no tempo</string>
    <string name="learn_l_rhy_5_s2_text">A canção da aula Dó, Ré, Mi, agora com as colcheias no tempo.</string>
    <string name="learn_l_rhy_6_title">O ponto de aumento</string>
    <string name="learn_l_rhy_6_summary">O ponto soma metade da duração</string>
    <string name="learn_l_rhy_6_s1_title">Mínima com ponto</string>
    <string name="learn_l_rhy_6_s1_text">O ponto depois da nota soma metade do valor dela. A mínima com ponto dura três pulsos.</string>
    <string name="learn_l_rhy_6_s2_title">Semínima com ponto</string>
    <string name="learn_l_rhy_6_s2_text">Dura um pulso e meio, e costuma vir seguida de uma colcheia, que entra entre o segundo e o terceiro clique.</string>
    <string name="learn_l_rhy_6_s3_title">Música: Ode à Alegria no tempo</string>
    <string name="learn_l_rhy_6_s3_text">A semínima com ponto aparece no fim da frase.</string>
    <string name="learn_l_rhy_7_title">Compasso de 3</string>
    <string name="learn_l_rhy_7_summary">A valsa</string>
    <string name="learn_l_rhy_7_s1_title">Conte até 3</string>
    <string name="learn_l_rhy_7_s1_text">Com o 3 em cima, cada compasso tem três pulsos. O primeiro continua mais forte: um, dois, três.</string>
    <string name="learn_l_rhy_7_s2_title">Música: Minueto em Sol</string>
    <string name="learn_l_rhy_7_s2_text">O começo do minueto do caderno de Anna Magdalena Bach, em três tempos.</string>
    <string name="learn_m_keys_title">Tonalidades</string>
    <string name="learn_m_keys_summary">Armadura de clave e escalas</string>
    <string name="learn_l_key_1_title">A armadura de clave</string>
    <string name="learn_l_key_1_summary">Sustenidos e bemóis fixos</string>
    <string name="learn_l_key_1_s1_title">Sinais logo depois da clave</string>
    <string name="learn_l_key_1_s1_text">A armadura vale para a música toda. Aqui o sustenido está na linha do Fá: todo Fá é Fá♯, mesmo sem sinal ao lado da nota. Toque os dois.</string>
    <string name="learn_l_key_1_s2_title">Lembre da armadura</string>
    <string name="learn_l_key_1_s2_text">Todo Fá desta pauta é Fá♯.</string>
    <string name="learn_l_key_2_title">Escala de Sol maior</string>
    <string name="learn_l_key_2_summary">Um sustenido na armadura</string>
    <string name="learn_l_key_2_s1_title">Sol maior</string>
    <string name="learn_l_key_2_s1_text">Começa no Sol e tem o Fá♯. É o mesmo desenho de distâncias da escala de Dó. Suba pelas teclas acesas.</string>
    <string name="learn_l_key_2_s2_title">Descendo sem ajuda</string>
    <string name="learn_l_key_2_s2_text">Agora o caminho de volta.</string>
    <string name="learn_l_key_2_s3_title">Treino</string>
    <string name="learn_l_key_2_s3_text">Dez notas sorteadas em Sol maior.</string>
    <string name="learn_l_key_3_title">Escala de Fá maior</string>
    <string name="learn_l_key_3_summary">Um bemol na armadura</string>
    <string name="learn_l_key_3_s1_title">Fá maior</string>
    <string name="learn_l_key_3_s1_text">Começa no Fá e tem o Si♭. O bemol na armadura fica na linha do Si. Suba pelas teclas acesas.</string>
    <string name="learn_l_key_3_s2_title">Descendo sem ajuda</string>
    <string name="learn_l_key_3_s2_text">Agora o caminho de volta.</string>
    <string name="learn_l_key_3_s3_title">Treino</string>
    <string name="learn_l_key_3_s3_text">Dez notas sorteadas em Fá maior.</string>
    <string name="learn_l_key_4_title">Desafio das armaduras</string>
    <string name="learn_l_key_4_summary">Notas sorteadas em cada tonalidade</string>
    <string name="learn_l_key_4_s1_title">Sol maior</string>
    <string name="learn_l_key_4_s1_text">Todo Fá é sustenido.</string>
    <string name="learn_l_key_4_s2_title">Fá maior</string>
    <string name="learn_l_key_4_s2_text">Todo Si é bemol.</string>
    <string name="learn_m_hands_title">Mãos juntas e acordes</string>
    <string name="learn_m_hands_summary">Várias notas ao mesmo tempo</string>
    <string name="learn_l_hands_1_title">As duas mãos juntas</string>
    <string name="learn_l_hands_1_summary">Uma nota em cada pauta</string>
    <string name="learn_l_hands_1_s1_title">Notas alinhadas</string>
    <string name="learn_l_hands_1_s1_text">Notas na mesma coluna das duas pautas são tocadas ao mesmo tempo: a mesma nota em cada mão, uma oitava de distância. Com o microfone, toque as duas juntas.</string>
    <string name="learn_l_hands_1_s2_title">Sem ajuda</string>
    <string name="learn_l_hands_1_s2_text">Leia as duas pautas.</string>
    <string name="learn_l_hands_2_title">Melodia e baixo</string>
    <string name="learn_l_hands_2_summary">Cada mão com a sua nota</string>
    <string name="learn_l_hands_2_s1_title">Mão esquerda parada</string>
    <string name="learn_l_hands_2_s1_text">A mão esquerda fica no Dó e a direita caminha. Siga as teclas acesas.</string>
    <string name="learn_l_hands_2_s2_title">As duas mãos mudam</string>
    <string name="learn_l_hands_2_s2_text">Agora a mão esquerda também muda.</string>
    <string name="learn_l_chord_1_title">O acorde de Dó maior</string>
    <string name="learn_l_chord_1_summary">Três notas juntas</string>
    <string name="learn_l_chord_1_s1_title">O que é um acorde</string>
    <string name="learn_l_chord_1_s1_text">São três ou mais notas tocadas juntas. O acorde de Dó maior usa Dó, Mi e Sol, empilhadas na pauta. Na tela, pode tocar uma tecla de cada vez; no piano, toque as três juntas.</string>
    <string name="learn_l_chord_1_s2_title">Três vezes</string>
    <string name="learn_l_chord_1_s2_text">Toque o acorde três vezes.</string>
    <string name="learn_l_chord_2_title">Fá e Sol maior</string>
    <string name="learn_l_chord_2_summary">Mais dois acordes</string>
    <string name="learn_l_chord_2_s1_title">Mesmo desenho</string>
    <string name="learn_l_chord_2_s1_text">Os acordes de Fá maior e de Sol maior têm o mesmo formato: uma nota sim, uma não. Toque os dois.</string>
    <string name="learn_l_chord_2_s2_title">Leia os acordes</string>
    <string name="learn_l_chord_2_s2_text">Leia as notas empilhadas.</string>
    <string name="learn_l_chord_3_title">Sequência de acordes</string>
    <string name="learn_l_chord_3_summary">Dó, Fá, Sol, Dó</string>
    <string name="learn_l_chord_3_s1_title">Dó, Fá, Sol, Dó</string>
    <string name="learn_l_chord_3_s1_text">Esta sequência aparece em muitas músicas.</string>
    <string name="learn_l_chord_3_s2_title">No tempo</string>
    <string name="learn_l_chord_3_s2_text">Um acorde a cada compasso.</string>
    <string name="learn_c_read_song">Leia a música</string>
    <string name="learn_c_play_along">Tocando junto</string>
    <string name="learn_c_play_along_text">Agora no tempo: o app toca a música com você.</string>
    <string name="learn_m_songs_title">Primeiras músicas</string>
    <string name="learn_m_songs_summary">Melodias conhecidas, do início ao fim</string>
    <string name="learn_l_song_1_title">Brilha, Brilha, Estrelinha</string>
    <string name="learn_l_song_1_summary">Melodia tradicional</string>
    <string name="learn_l_song_1_intro">Uma melodia tradicional, só com semínimas e mínimas.</string>
    <string name="learn_l_song_2_summary">Canção tradicional</string>
    <string name="learn_l_song_2_intro">Canção tradicional, com a mão direita perto do Dó central.</string>
    <string name="learn_l_song_3_summary">Canção tradicional francesa</string>
    <string name="learn_l_song_3_intro">Canção tradicional francesa. O último trecho desce até o Sol abaixo do Dó central.</string>
    <string name="learn_l_song_4_title">Ode à Alegria</string>
    <string name="learn_l_song_4_summary">Beethoven, 9ª Sinfonia</string>
    <string name="learn_l_song_4_intro">O tema da 9ª Sinfonia de Beethoven. Atenção à semínima com ponto no fim das frases.</string>
    <string name="learn_m_ear_title">Ouvido</string>
    <string name="learn_m_ear_summary">Descobrir as notas sem ver a pauta</string>
    <string name="learn_l_ear_1_title">Dó, Mi e Sol de ouvido</string>
    <string name="learn_l_ear_1_summary">Três notas, sem pauta</string>
    <string name="learn_l_ear_1_s1_title">Três notas</string>
    <string name="learn_l_ear_1_s1_text">O app toca três notas entre Dó, Mi e Sol. Descubra quais são e toque na mesma ordem. Cada nota aparece na pauta quando você acerta.</string>
    <string name="learn_l_ear_1_s2_title">Quatro notas</string>
    <string name="learn_l_ear_1_s2_text">Agora quatro notas entre Dó, Mi e Sol. Toque em Ouvir para escutar de novo.</string>
    <string name="learn_l_ear_2_title">Do Dó ao Sol de ouvido</string>
    <string name="learn_l_ear_2_summary">Cinco notas vizinhas</string>
    <string name="learn_l_ear_2_s1_title">Três notas</string>
    <string name="learn_l_ear_2_s1_text">Três notas entre Dó e Sol. Comece pelo Dó central e vá comparando.</string>
    <string name="learn_l_ear_2_s2_title">Quatro notas</string>
    <string name="learn_l_ear_2_s2_text">Quatro notas entre Dó e Sol.</string>


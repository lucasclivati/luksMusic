    <string name="learn_m_ear_title">Heard</string>
    <string name="learn_m_ear_summary">Finding the notes without seeing the staff</string>
    <string name="learn_l_ear_1_title">C, E and G by ear</string>
    <string name="learn_l_ear_1_summary">Three notes, no staff</string>
    <string name="learn_l_ear_1_s1_title">Three notes</string>
    <string name="learn_l_ear_1_s1_text">The app plays three notes from C, E and G. Figure out which ones they are and play them in the same order. Each note appears on the staff when you get it right.</string>
    <string name="learn_l_ear_1_s2_title">Four notes</string>
    <string name="learn_l_ear_1_s2_text">Now four notes from C, E and G. Tap Listen to hear them again.</string>
    <string name="learn_l_ear_2_title">C to G by ear</string>
    <string name="learn_l_ear_2_summary">Five neighboring notes</string>
    <string name="learn_l_ear_2_s1_title">Three notes</string>
    <string name="learn_l_ear_2_s1_text">Three notes between C and G. Start from middle C and compare as you go.</string>
    <string name="learn_l_ear_2_s2_title">Four notes</string>
    <string name="learn_l_ear_2_s2_text">Four notes between C and G.</string>

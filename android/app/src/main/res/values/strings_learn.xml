    <!-- The course (core/lessons/LessonCatalog.kt) -->
    <string name="learn_c_drill">No help. Miss twice and the key lights up.</string>
    <string name="learn_c_at_your_pace">Tap Listen to hear it, then read and play at your own pace.</string>
    <string name="learn_m_treble_title">Treble clef</string>
    <string name="learn_m_treble_summary">Right hand, from middle C up</string>
    <string name="learn_l_treble_1_title">How to read sheet music</string>
    <string name="learn_l_treble_1_summary">Intro video, your first notes, and your first song</string>
    <string name="learn_l_treble_1_s1_title">How sheet music begins</string>
    <string name="learn_l_treble_1_s1_text">Watch how the lines work and how each key climbs half a line to complete one octave.</string>
    <string name="learn_l_treble_1_s2_title">Find C, D and E</string>
    <string name="learn_l_treble_1_s2_text">C sits to the left of the 2 black keys, on the short line below the staff. Each key to the right climbs one step. Play C, D and E.</string>
    <string name="learn_l_treble_1_s3_title">Climbing one octave</string>
    <string name="learn_l_treble_1_s3_text">Now go up one key per note all the way to the next C, just like you saw in the video.</string>
    <string name="learn_l_treble_1_s4_title">Song: Au Clair de la Lune (opening)</string>
    <string name="learn_l_treble_1_s4_text">Song time! Play the opening phrase of this traditional French melody using only C, D and E.</string>
    <string name="learn_l_treble_1_s5_title">Challenge: full Au Clair de la Lune</string>
    <string name="learn_l_treble_1_s5_text">To finish the lesson, play the full melody on your own from start to finish.</string>
    <string name="learn_l_treble_2_title">C, D, E</string>
    <string name="learn_l_treble_2_summary">The first three notes</string>
    <string name="learn_l_treble_2_s1_title">New note: D</string>
    <string name="learn_l_treble_2_s1_text">It\'s the white key just to the right of C. On the staff, it sits just below the first line. Play D.</string>
    <string name="learn_l_treble_2_s2_title">New note: E</string>
    <string name="learn_l_treble_2_s2_text">It\'s the next white key. On the staff, it sits on the first line. Play E.</string>
    <string name="learn_l_treble_2_s3_title">Practice</string>
    <string name="learn_l_treble_2_s3_text">Ten random notes from C, D and E.</string>
    <string name="learn_l_treble_2_s4_title">Song: Hot Cross Buns</string>
    <string name="learn_l_treble_2_s4_text">An English nursery rhyme that uses only E, D and C.</string>
    <string name="learn_l_treble_3_title">F and G</string>
    <string name="learn_l_treble_3_summary">The treble clef marks the G line</string>
    <string name="learn_l_treble_3_s1_title">New note: F</string>
    <string name="learn_l_treble_3_s1_text">It\'s the white key just to the left of the group of 3 black keys. On the staff, it sits in the first space. Play F.</string>
    <string name="learn_l_treble_3_s2_title">New note: G</string>
    <string name="learn_l_treble_3_s2_text">It sits on the second line, the one the curl of the treble clef wraps around. That\'s why this clef is also called the G clef. Play G.</string>
    <string name="learn_l_treble_3_s3_title">Practice</string>
    <string name="learn_l_treble_3_s3_text">Ten random notes from C to G.</string>
    <string name="learn_l_treble_3_s4_title">Song: Ode to Joy (opening)</string>
    <string name="learn_l_treble_3_s4_text">Try the opening of Beethoven\'s theme using D through G.</string>
    <string name="learn_l_treble_3_s5_title">Challenge: Ode to Joy</string>
    <string name="learn_l_treble_3_s5_text">Now play Beethoven\'s complete phrase on your own.</string>
    <string name="learn_l_treble_4_title">A, B and the other C</string>
    <string name="learn_l_treble_4_summary">Up to the upper C</string>
    <string name="learn_l_treble_4_s1_title">New note: A</string>
    <string name="learn_l_treble_4_s1_text">It comes after G. On the staff, it sits in the second space. Play A.</string>
    <string name="learn_l_treble_4_s2_title">New note: B</string>
    <string name="learn_l_treble_4_s2_text">It sits on the third line, right in the middle of the staff. Play B.</string>
    <string name="learn_l_treble_4_s3_title">New note: the upper C</string>
    <string name="learn_l_treble_4_s3_text">After B, the names start over. This C is the eighth note up from middle C, and it sits in the third space. Play it.</string>
    <string name="learn_l_treble_4_s4_title">Practice</string>
    <string name="learn_l_treble_4_s4_text">Ten random notes from middle C to the upper C.</string>
    <string name="learn_l_treble_4_s5_title">Song: Twinkle, Twinkle, Little Star (opening)</string>
    <string name="learn_l_treble_4_s5_text">Play the opening of this traditional melody climbing up to A.</string>
    <string name="learn_l_treble_4_s6_title">Challenge: Twinkle, Twinkle, Little Star</string>
    <string name="learn_l_treble_4_s6_text">Now play the full passage on your own all the way back to C.</string>
    <string name="learn_l_treble_5_title">Up the scale</string>
    <string name="learn_l_treble_5_summary">From middle C to the upper C</string>
    <string name="learn_l_treble_5_s1_title">The C scale</string>
    <string name="learn_l_treble_5_s1_text">Eight neighboring notes, all on white keys. On the staff, each note goes up one step: line, space, line, space. Go up the lit keys.</string>
    <string name="learn_l_treble_5_s2_title">Going up without help</string>
    <string name="learn_l_treble_5_s2_text">Read the staff and go up to the upper C.</string>
    <string name="learn_l_treble_5_s3_title">Lines and spaces</string>
    <string name="learn_l_treble_5_s3_text">First the notes on the lines, then the ones in the spaces: skipping one key each time.</string>
    <string name="learn_l_treble_6_title">Down the scale</string>
    <string name="learn_l_treble_6_summary">The way back</string>
    <string name="learn_l_treble_6_s1_title">Going down</string>
    <string name="learn_l_treble_6_s1_text">Now the other way: start on the upper C and go down one step at a time to middle C, along the lit keys.</string>
    <string name="learn_l_treble_6_s2_title">Going down without help</string>
    <string name="learn_l_treble_6_s2_text">Read the staff and go down to middle C.</string>
    <string name="learn_l_treble_6_s3_title">Practice</string>
    <string name="learn_l_treble_6_s3_text">Ten random notes from C to C.</string>
    <string name="learn_l_treble_7_title">Upper D, E, F and G</string>
    <string name="learn_l_treble_7_summary">The top of the staff</string>
    <string name="learn_l_treble_7_s1_title">New notes: D and E</string>
    <string name="learn_l_treble_7_s1_text">D sits on the fourth line, and E in the fourth space. Play both.</string>
    <string name="learn_l_treble_7_s2_title">New notes: F and G</string>
    <string name="learn_l_treble_7_s2_text">F sits on the fifth line, the top one. G sits just above it. Play both.</string>
    <string name="learn_l_treble_7_s3_title">Practice</string>
    <string name="learn_l_treble_7_s3_text">Ten random notes from G to the upper G.</string>
    <string name="learn_l_treble_7_s4_title">Song: Ode to Joy, an octave higher</string>
    <string name="learn_l_treble_7_s4_text">The same melody as in the F and G lesson, eight notes higher: same keys, further to the right.</string>
    <string name="learn_l_treble_8_title">Ledger lines above</string>
    <string name="learn_l_treble_8_summary">A, B and C above the staff</string>
    <string name="learn_l_treble_8_s1_title">New note: high A</string>
    <string name="learn_l_treble_8_s1_text">When a note goes above the five lines, the staff gets short extra lines, called ledger lines. A sits on the first ledger line above the staff. Play A.</string>
    <string name="learn_l_treble_8_s2_title">New notes: high B and C</string>
    <string name="learn_l_treble_8_s2_text">B sits just above that line. C sits on the second ledger line. Play both.</string>
    <string name="learn_l_treble_8_s3_title">Practice</string>
    <string name="learn_l_treble_8_s3_text">Ten random notes at the top of the staff.</string>
    <string name="learn_l_treble_9_title">Treble clef challenge</string>
    <string name="learn_l_treble_9_summary">Whole-staff reading and full song</string>
    <string name="learn_l_treble_9_s1_title">Up to the upper C</string>
    <string name="learn_l_treble_9_s1_text">Ten random notes.</string>
    <string name="learn_l_treble_9_s2_title">The whole staff</string>
    <string name="learn_l_treble_9_s2_text">Ten random notes, from middle C to the highest C.</string>
    <string name="learn_l_treble_9_s3_title">Challenge: full Ode to Joy</string>
    <string name="learn_l_treble_9_s3_text">Play both complete parts of Beethoven\'s theme on your own to finish the module.</string>
    <string name="learn_m_bass_title">Bass clef</string>
    <string name="learn_m_bass_summary">Left hand, from middle C down</string>
    <string name="learn_l_bass_1_title">The bass clef</string>
    <string name="learn_l_bass_1_summary">The left hand\'s staff</string>
    <string name="learn_l_bass_1_s1_title">New note: the bass clef\'s F</string>
    <string name="learn_l_bass_1_s1_text">The left hand usually reads this clef. Its two dots sit on either side of the fourth line, and that line is F. Play it with your left hand.</string>
    <string name="learn_l_bass_1_s2_title">The same middle C</string>
    <string name="learn_l_bass_1_s2_text">In this clef, middle C sits on a ledger line above the five lines. It\'s the same key as in the treble clef. Play it.</string>
    <string name="learn_l_bass_1_s3_title">Your turn</string>
    <string name="learn_l_bass_1_s3_text">Read the staff: only F and C.</string>
    <string name="learn_l_bass_2_title">B, A and G</string>
    <string name="learn_l_bass_2_summary">Going down from middle C</string>
    <string name="learn_l_bass_2_s1_title">New note: B</string>
    <string name="learn_l_bass_2_s1_text">It\'s the key just to the left of middle C. On the staff, it sits just above the fifth line. Play B.</string>
    <string name="learn_l_bass_2_s2_title">New notes: A and G</string>
    <string name="learn_l_bass_2_s2_text">A sits on the fifth line, the top one. G sits in the fourth space. Play both.</string>
    <string name="learn_l_bass_2_s3_title">Practice</string>
    <string name="learn_l_bass_2_s3_text">Ten random notes from middle C down to F.</string>
    <string name="learn_l_bass_2_s4_title">Song: Hot Cross Buns with the left hand</string>
    <string name="learn_l_bass_2_s4_text">The treble clef song, now with B, A and G.</string>
    <string name="learn_l_bass_3_title">E, D and C</string>
    <string name="learn_l_bass_3_summary">The middle of the left hand\'s staff</string>
    <string name="learn_l_bass_3_s1_title">New note: E</string>
    <string name="learn_l_bass_3_s1_text">It sits in the third space, just below F. Play E.</string>
    <string name="learn_l_bass_3_s2_title">New notes: D and C</string>
    <string name="learn_l_bass_3_s2_text">D sits on the third line, in the middle of the staff. C sits in the second space. Play both.</string>
    <string name="learn_l_bass_3_s3_title">Practice</string>
    <string name="learn_l_bass_3_s3_text">Ten random notes from middle C to the lower C.</string>
    <string name="learn_l_bass_3_s4_title">Song: Ode to Joy with the left hand</string>
    <string name="learn_l_bass_3_s4_text">Beethoven\'s theme, eight notes lower.</string>
    <string name="learn_l_bass_4_title">Down and up</string>
    <string name="learn_l_bass_4_summary">From middle C to the lower C, and back</string>
    <string name="learn_l_bass_4_s1_title">The scale in the bass clef</string>
    <string name="learn_l_bass_4_s1_text">The same eight note names, an octave lower: from middle C to the C in the second space. Go down the lit keys.</string>
    <string name="learn_l_bass_4_s2_title">Going down without help</string>
    <string name="learn_l_bass_4_s2_text">Read the staff and go down.</string>
    <string name="learn_l_bass_4_s3_title">Going up without help</string>
    <string name="learn_l_bass_4_s3_text">Now the other way.</string>
    <string name="learn_l_bass_5_title">The lowest notes</string>
    <string name="learn_l_bass_5_summary">Down to the C on ledger lines below</string>
    <string name="learn_l_bass_5_s1_title">New notes: low B, A and G</string>
    <string name="learn_l_bass_5_s1_text">B sits on the second line, A in the first space, and G on the first line. Play all three.</string>
    <string name="learn_l_bass_5_s2_title">Below the staff</string>
    <string name="learn_l_bass_5_s2_text">F sits just below the first line. E sits on a ledger line, D just below it, and C on the second ledger line. Play all four.</string>
    <string name="learn_l_bass_5_s3_title">Practice</string>
    <string name="learn_l_bass_5_s3_text">Ten random low notes.</string>
    <string name="learn_l_bass_6_title">Bass clef challenge</string>
    <string name="learn_l_bass_6_summary">Random notes, no help</string>
    <string name="learn_l_bass_6_s1_title">Down to the lower C</string>
    <string name="learn_l_bass_6_s1_text">Ten random notes.</string>
    <string name="learn_l_bass_6_s2_title">The whole staff</string>
    <string name="learn_l_bass_6_s2_text">Ten random notes, from middle C to the lowest C.</string>
    <string name="learn_m_grand_title">Both clefs</string>
    <string name="learn_m_grand_summary">The whole piano on a grand staff</string>
    <string name="learn_l_grand_1_title">Middle C is the same</string>
    <string name="learn_l_grand_1_summary">Where the two clefs meet</string>
    <string name="learn_l_grand_1_s1_title">Two staves, one piano</string>
    <string name="learn_l_grand_1_s1_text">The bass clef covers the left half of the piano, and the treble clef the right half. They meet at middle C, which sits on a ledger line in each. Play it twice.</string>
    <string name="learn_l_grand_1_s2_title">Up the keyboard</string>
    <string name="learn_l_grand_1_s2_text">From left to right, the notes climb the lower staff and carry on in the upper one. Start with your left hand and switch to your right at middle C.</string>
    <string name="learn_l_grand_1_s3_title">Going down without help</string>
    <string name="learn_l_grand_1_s3_text">Read both staves.</string>
    <string name="learn_l_grand_2_title">Reading both staves</string>
    <string name="learn_l_grand_2_summary">The note can be in either clef</string>
    <string name="learn_l_grand_2_s1_title">Which staff?</string>
    <string name="learn_l_grand_2_s1_text">Check the clef first, then the note.</string>
    <string name="learn_l_grand_2_s2_title">Practice</string>
    <string name="learn_l_grand_2_s2_text">Ten random notes on both staves.</string>
    <string name="learn_l_grand_3_title">Two-clef challenge</string>
    <string name="learn_l_grand_3_summary">Random notes on both staves</string>
    <string name="learn_l_grand_3_s1_title">Challenge</string>
    <string name="learn_l_grand_3_s1_text">Sixteen random notes on both staves.</string>
    <string name="learn_m_accidentals_title">Sharps and flats</string>
    <string name="learn_m_accidentals_summary">The black keys</string>
    <string name="learn_l_acc_1_title">The sharp</string>
    <string name="learn_l_acc_1_summary">Raises a note a half step</string>
    <string name="learn_l_acc_1_s1_title">The ♯ sign</string>
    <string name="learn_l_acc_1_s1_text">A sharp raises a note a half step: play the key just to the right. It\'s written before the note, at the same height. Play F and F♯.</string>
    <string name="learn_l_acc_1_s2_title">The black keys</string>
    <string name="learn_l_acc_1_s2_text">C♯, D♯, F♯, G♯ and A♯ are the five black keys in each octave. Play all five.</string>
    <string name="learn_l_acc_1_s3_title">Practice</string>
    <string name="learn_l_acc_1_s3_text">Ten random notes, on white and black keys.</string>
    <string name="learn_l_acc_2_title">The flat</string>
    <string name="learn_l_acc_2_summary">Lowers a note a half step</string>
    <string name="learn_l_acc_2_s1_title">The ♭ sign</string>
    <string name="learn_l_acc_2_s1_text">A flat lowers a note a half step: play the key just to the left. Play B and B♭.</string>
    <string name="learn_l_acc_2_s2_title">The black keys again</string>
    <string name="learn_l_acc_2_s2_text">D♭, E♭, G♭, A♭ and B♭ are the same five black keys, with other names. Play all five.</string>
    <string name="learn_l_acc_2_s3_title">Practice</string>
    <string name="learn_l_acc_2_s3_text">Ten random notes, on white and black keys.</string>
    <string name="learn_l_acc_3_title">One key, two names</string>
    <string name="learn_l_acc_3_summary">C♯ and D♭ are the same key</string>
    <string name="learn_l_acc_3_s1_title">The same sound</string>
    <string name="learn_l_acc_3_s1_text">C♯ and D♭ are written in different places on the staff, but they\'re the same black key. Play both.</string>
    <string name="learn_l_acc_3_s2_title">Pairs</string>
    <string name="learn_l_acc_3_s2_text">Each pair of neighboring notes is a single key.</string>
    <string name="learn_l_acc_4_title">The natural</string>
    <string name="learn_l_acc_4_summary">Cancels the sharp or the flat</string>
    <string name="learn_l_acc_4_s1_title">It lasts until the end of the measure</string>
    <string name="learn_l_acc_4_s1_text">After a sharp, the same notes that follow stay raised until the bar line, even without the sign. Play both F♯s.</string>
    <string name="learn_l_acc_4_s2_title">The ♮ sign</string>
    <string name="learn_l_acc_4_s2_text">A natural cancels the sharp or flat, and the note goes back to the white key. Play all three.</string>
    <string name="learn_l_acc_4_s3_title">The bar line cancels the sign</string>
    <string name="learn_l_acc_4_s3_text">In the second measure, the sharp has to be written again. Watch out for the note without a sign.</string>
    <string name="learn_l_acc_5_title">Accidentals challenge</string>
    <string name="learn_l_acc_5_summary">Random white and black keys</string>
    <string name="learn_l_acc_5_s1_title">Sharps</string>
    <string name="learn_l_acc_5_s1_text">Ten random notes.</string>
    <string name="learn_l_acc_5_s2_title">Flats</string>
    <string name="learn_l_acc_5_s2_text">Ten random notes.</string>
    <string name="learn_m_rhythm_title">Rhythm</string>
    <string name="learn_m_rhythm_summary">How long each note lasts</string>
    <string name="learn_l_rhy_1_title">The beat and the quarter note</string>
    <string name="learn_l_rhy_1_summary">Playing along with the metronome</string>
    <string name="learn_l_rhy_1_s1_title">One note per beat</string>
    <string name="learn_l_rhy_1_s1_text">Music has a steady pulse, the beat, which the metronome keeps. A quarter note lasts one beat. Tap Start: the metronome counts 4 beats, then you play one note on each click.</string>
    <string name="learn_l_rhy_1_s2_title">Changing notes</string>
    <string name="learn_l_rhy_1_s2_text">The same beat, with different notes.</string>
    <string name="learn_l_rhy_2_title">Half and whole notes</string>
    <string name="learn_l_rhy_2_summary">2-beat and 4-beat notes</string>
    <string name="learn_l_rhy_2_s1_title">The half note</string>
    <string name="learn_l_rhy_2_s1_text">A half note has a hollow head and lasts two beats: play it and hold it for two clicks.</string>
    <string name="learn_l_rhy_2_s2_title">The whole note</string>
    <string name="learn_l_rhy_2_s2_text">A whole note has no stem and lasts four beats, the whole measure.</string>
    <string name="learn_l_rhy_3_title">The measure</string>
    <string name="learn_l_rhy_3_summary">Beats in groups</string>
    <string name="learn_l_rhy_3_s1_title">Two measures</string>
    <string name="learn_l_rhy_3_s1_text">Bar lines divide the music into groups of beats. The top 4 says each measure has four beats; the bottom 4, that a quarter note gets one beat. The first click of each measure is louder.</string>
    <string name="learn_l_rhy_3_s2_title">Song: Mary Had a Little Lamb</string>
    <string name="learn_l_rhy_3_s2_text">Now a song in time, with the app playing along.</string>
    <string name="learn_l_rhy_4_title">Rests</string>
    <string name="learn_l_rhy_4_summary">Silence has a length too</string>
    <string name="learn_l_rhy_4_s1_title">Quarter rest</string>
    <string name="learn_l_rhy_4_s1_text">A rest is a moment of silence. This one lasts one beat: play nothing and wait for the next click.</string>
    <string name="learn_l_rhy_4_s2_title">Long rests</string>
    <string name="learn_l_rhy_4_s2_text">A half rest sits on top of the third line and lasts two beats. Count the clicks during it.</string>
    <string name="learn_l_rhy_5_title">Eighth notes</string>
    <string name="learn_l_rhy_5_summary">Two notes on each beat</string>
    <string name="learn_l_rhy_5_s1_title">Two per beat</string>
    <string name="learn_l_rhy_5_s1_text">An eighth note has a small flag and lasts half a beat: one on the click and the other between clicks.</string>
    <string name="learn_l_rhy_5_s2_title">Song: Hot Cross Buns in time</string>
    <string name="learn_l_rhy_5_s2_text">The song from the C, D, E lesson, now with the eighth notes in time.</string>
    <string name="learn_l_rhy_6_title">Dotted notes</string>
    <string name="learn_l_rhy_6_summary">A dot adds half the length</string>
    <string name="learn_l_rhy_6_s1_title">Dotted half note</string>
    <string name="learn_l_rhy_6_s1_text">A dot after a note adds half its value. A dotted half note lasts three beats.</string>
    <string name="learn_l_rhy_6_s2_title">Dotted quarter note</string>
    <string name="learn_l_rhy_6_s2_text">It lasts a beat and a half and is usually followed by an eighth note, which comes between the second and third clicks.</string>
    <string name="learn_l_rhy_6_s3_title">Song: Ode to Joy in time</string>
    <string name="learn_l_rhy_6_s3_text">The dotted quarter note comes at the end of the phrase.</string>
    <string name="learn_l_rhy_7_title">Three beats per measure</string>
    <string name="learn_l_rhy_7_summary">The waltz</string>
    <string name="learn_l_rhy_7_s1_title">Count to 3</string>
    <string name="learn_l_rhy_7_s1_text">With a 3 on top, each measure has three beats. The first is still the strongest: one, two, three.</string>
    <string name="learn_l_rhy_7_s2_title">Song: Minuet in G</string>
    <string name="learn_l_rhy_7_s2_text">The opening of the minuet from the Anna Magdalena Bach Notebook, with three beats per measure.</string>
    <string name="learn_m_keys_title">Musical keys</string>
    <string name="learn_m_keys_summary">Key signatures and scales</string>
    <string name="learn_l_key_1_title">The key signature</string>
    <string name="learn_l_key_1_summary">Sharps and flats that stay</string>
    <string name="learn_l_key_1_s1_title">Signs right after the clef</string>
    <string name="learn_l_key_1_s1_text">The key signature applies to the whole piece. Here the sharp is on the F line: every F is F♯, even with no sign next to the note. Play both.</string>
    <string name="learn_l_key_1_s2_title">Remember the key signature</string>
    <string name="learn_l_key_1_s2_text">Every F on this staff is F♯.</string>
    <string name="learn_l_key_2_title">G major scale</string>
    <string name="learn_l_key_2_summary">One sharp in the key signature</string>
    <string name="learn_l_key_2_s1_title">G major</string>
    <string name="learn_l_key_2_s1_text">It starts on G and has F♯. It\'s the same pattern of steps as the C scale. Go up the lit keys.</string>
    <string name="learn_l_key_2_s2_title">Going down without help</string>
    <string name="learn_l_key_2_s2_text">Now the way back.</string>
    <string name="learn_l_key_2_s3_title">Practice</string>
    <string name="learn_l_key_2_s3_text">Ten random notes in G major.</string>
    <string name="learn_l_key_3_title">F major scale</string>
    <string name="learn_l_key_3_summary">One flat in the key signature</string>
    <string name="learn_l_key_3_s1_title">F major</string>
    <string name="learn_l_key_3_s1_text">It starts on F and has B♭. The flat in the key signature sits on the B line. Go up the lit keys.</string>
    <string name="learn_l_key_3_s2_title">Going down without help</string>
    <string name="learn_l_key_3_s2_text">Now the way back.</string>
    <string name="learn_l_key_3_s3_title">Practice</string>
    <string name="learn_l_key_3_s3_text">Ten random notes in F major.</string>
    <string name="learn_l_key_4_title">Key signature challenge</string>
    <string name="learn_l_key_4_summary">Random notes in each key</string>
    <string name="learn_l_key_4_s1_title">G major</string>
    <string name="learn_l_key_4_s1_text">Every F is sharp.</string>
    <string name="learn_l_key_4_s2_title">F major</string>
    <string name="learn_l_key_4_s2_text">Every B is flat.</string>
    <string name="learn_m_hands_title">Hands together and chords</string>
    <string name="learn_m_hands_summary">Several notes at once</string>
    <string name="learn_l_hands_1_title">Both hands together</string>
    <string name="learn_l_hands_1_summary">One note on each staff</string>
    <string name="learn_l_hands_1_s1_title">Lined-up notes</string>
    <string name="learn_l_hands_1_s1_text">Notes in the same column on both staves are played at the same time: the same note in each hand, an octave apart. With the microphone, play both together.</string>
    <string name="learn_l_hands_1_s2_title">Without help</string>
    <string name="learn_l_hands_1_s2_text">Read both staves.</string>
    <string name="learn_l_hands_2_title">Melody and bass</string>
    <string name="learn_l_hands_2_summary">Each hand plays its own note</string>
    <string name="learn_l_hands_2_s1_title">Left hand stays put</string>
    <string name="learn_l_hands_2_s1_text">The left hand stays on C while the right hand moves. Follow the lit keys.</string>
    <string name="learn_l_hands_2_s2_title">Both hands move</string>
    <string name="learn_l_hands_2_s2_text">Now the left hand moves too.</string>
    <string name="learn_l_chord_1_title">The C major chord</string>
    <string name="learn_l_chord_1_summary">Three notes together</string>
    <string name="learn_l_chord_1_s1_title">What a chord is</string>
    <string name="learn_l_chord_1_s1_text">A chord is three or more notes played together. The C major chord uses C, E and G, stacked on the staff. On the screen you can play one key at a time; on a piano, play all three together.</string>
    <string name="learn_l_chord_1_s2_title">Three times</string>
    <string name="learn_l_chord_1_s2_text">Play the chord three times.</string>
    <string name="learn_l_chord_2_title">F and G major</string>
    <string name="learn_l_chord_2_summary">Two more chords</string>
    <string name="learn_l_chord_2_s1_title">Same shape</string>
    <string name="learn_l_chord_2_s1_text">The F major and G major chords have the same shape: every other note. Play both.</string>
    <string name="learn_l_chord_2_s2_title">Read the chords</string>
    <string name="learn_l_chord_2_s2_text">Read the stacked notes.</string>
    <string name="learn_l_chord_3_title">Chord progression</string>
    <string name="learn_l_chord_3_summary">C, F, G, C</string>
    <string name="learn_l_chord_3_s1_title">C, F, G, C</string>
    <string name="learn_l_chord_3_s1_text">This progression shows up in lots of songs.</string>
    <string name="learn_l_chord_3_s2_title">In time</string>
    <string name="learn_l_chord_3_s2_text">One chord per measure.</string>
    <string name="learn_c_read_song">Read the song</string>
    <string name="learn_c_play_along">Playing along</string>
    <string name="learn_c_play_along_text">Now in time: the app plays the song with you.</string>

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's synced library (iOS app): only the signed-in owner can read, write or delete it.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Visibility of the web player's scores: everyone reads it, only the author changes it.
    match /scoreSettings/{scoreId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'lukscli@gmail.com'
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['privacy', 'updatedAt'])
        && request.resource.data.privacy in ['public', 'private'];
    }
  }
}
